msgstr "Voces de la Iglesia"

#: catena_reader.py:33
msgid "Second Temple Judaism"
msgstr "Judaísmo del Segundo Templo"

#: catena_reader.py:34
msgid "Between the testaments, read for background, not authority."
msgstr "Entre los dos testamentos; se lee como trasfondo, no como autoridad."

#: catena_reader.py:36
msgid "Canonical Scriptures"
msgstr "Escrituras canónicas"

#: catena_reader.py:37
msgid "Scripture interprets Scripture: the New Testament on the Old."
msgstr ""
"La Escritura interpreta la Escritura: el Nuevo Testamento sobre el Antiguo."

#: catena_reader.py:39
msgid "Apocrypha & Pseudepigrapha"
msgstr "Apócrifos y pseudoepígrafos"

#: catena_reader.py:40
msgid "Valued by the church as history, never received as canon."
msgstr "La Iglesia los apreció como historia, nunca los recibió como canon."

#: catena_reader.py:42
msgid "Early Fathers (Pre-Nicaea)"
msgstr "Padres antiguos (antes de Nicea)"

#: catena_reader.py:43
msgid "The church of the martyrs, before the Council of Nicaea."
msgstr "La Iglesia de los mártires, antes del Concilio de Nicea."

#: catena_reader.py:45
msgid "Eastern & Byzantine"
msgstr "Oriente y Bizancio"

