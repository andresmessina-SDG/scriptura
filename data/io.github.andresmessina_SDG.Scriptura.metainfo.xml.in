<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application"
           xmlns:its="http://www.w3.org/2005/11/its" its:version="2.0">
  <id>io.github.andresmessina_SDG.Scriptura</id>

  <name>Scriptura</name>
  <summary>Read and study the Bible in depth</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.andresmessina_sdg">
    <name>Andres Messina</name>
  </developer>

  <description>
    <p>
      Scriptura is a Bible study app for the Linux desktop. Read two
      translations side by side, with a full study library a click away.
    </p>
    <p>It brings together:</p>
    <ul>
      <li>Two translations side by side that move together, a reading mode with nothing else on screen, and a full-screen mode for a projector.</li>
      <li>The Greek and Hebrew behind the text: click a word for its meaning and grammar, or read an interlinear word by word.</li>
      <li>Commentaries, devotionals and confessions, and how the church read each verse from the early fathers to the Reformers.</li>
      <li>340,000 cross-references, and fast search across any text you install.</li>
      <li>Highlights, notes and tags that show in every translation.</li>
      <li>A journal and sermon manuscripts, with your notes on the passage close at hand.</li>
      <li>Reading plans, and a Today page with the day's reading.</li>
      <li>Chapters and devotionals read aloud.</li>
      <li>Paintings, maps and archaeology for the passage you read, and the Bible's family lists drawn as charts.</li>
      <li>English, Spanish and Russian, with Bibles and dictionaries in each.</li>
    </ul>
    <p>
      Everything stays on your computer, with no account and no tracking.
      Scriptura goes online only to download the texts you choose and
      for spoken readings, which you can turn off in Preferences.
    </p>
  </description>

  <launchable type="desktop-id">io.github.andresmessina_SDG.Scriptura.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#8B6520</color>
    <color type="primary" scheme_preference="dark">#C49B35</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/01-two-pane-lexicon.png</image>
      <caption>Two-pane reading with the Strong's lexicon open on a Greek word</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/06-interlinear-greek.png</image>
      <caption>The Greek New Testament interlinear, with meaning, grammar and Strong's number under every word</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/02-historical-commentaries.png</image>
      <caption>Historical Commentaries: how the church read a verse across the centuries</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/03-study-journal.png</image>
      <caption>Annotations: every mark you have made, in one place</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/04-reading-plan.png</image>
      <caption>Built-in reading plans with day-by-day progress</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/05-reading-mode-dark.png</image>
      <caption>Reading mode hides everything but the text</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://andresmessina-sdg.github.io/scriptura/</url>
  <url type="bugtracker">https://github.com/andresmessina-SDG/scriptura/issues</url>
  <url type="vcs-browser">https://github.com/andresmessina-SDG/scriptura</url>
  <url type="contribute">https://github.com/andresmessina-SDG/scriptura</url>
  <url type="donation">https://ko-fi.com/andresmessina</url>

  <categories>
    <category>Education</category>
    <category>Literature</category>
  </categories>

  <keywords>
    <keyword>Bible</keyword>
    <keyword>Scripture</keyword>
    <keyword>Study</keyword>
    <keyword>SWORD</keyword>
    <keyword>Lexicon</keyword>
    <keyword translate="no">Strong's</keyword>
    <keyword>Devotional</keyword>
    <keyword>Commentary</keyword>
  </keywords>

  <!--
    <provides>, <requires>, <recommends>, <supports> blocks deliberately
    omitted for now. appstreamcli compose (run during Flatpak build)
    rejects them on some configurations and the error message
    ('file-read-error') doesn't point at the specific block. Once the
    build is green, we can re-add these one at a time to identify
    which one compose objects to.
  -->

  <!--
    Content rating: the app itself generates no content. It displays
    user-installed third-party scripture / commentary modules.
    Following the convention of other Bible apps on Flathub
    (BibleTime, Yetzirah), rate as "none" across the board.
  -->
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">none</content_attribute>
    <content_attribute id="violence-fantasy">none</content_attribute>
    <content_attribute id="violence-realistic">none</content_attribute>
    <content_attribute id="violence-bloodshed">none</content_attribute>
    <content_attribute id="violence-sexual">none</content_attribute>
    <content_attribute id="violence-desecration">none</content_attribute>
    <content_attribute id="violence-slavery">none</content_attribute>
    <content_attribute id="violence-worship">none</content_attribute>
    <content_attribute id="drugs-alcohol">none</content_attribute>
    <content_attribute id="drugs-narcotics">none</content_attribute>
    <content_attribute id="drugs-tobacco">none</content_attribute>
    <content_attribute id="sex-nudity">none</content_attribute>
    <content_attribute id="sex-themes">none</content_attribute>
    <content_attribute id="sex-homosexuality">none</content_attribute>
    <content_attribute id="sex-prostitution">none</content_attribute>
    <content_attribute id="sex-adultery">none</content_attribute>
    <content_attribute id="sex-appearance">none</content_attribute>
    <content_attribute id="language-profanity">none</content_attribute>
    <content_attribute id="language-humor">none</content_attribute>
    <content_attribute id="language-discrimination">none</content_attribute>
    <content_attribute id="social-chat">none</content_attribute>
    <content_attribute id="social-info">none</content_attribute>
    <content_attribute id="social-audio">none</content_attribute>
    <content_attribute id="social-location">none</content_attribute>
    <content_attribute id="social-contacts">none</content_attribute>
    <content_attribute id="money-purchasing">none</content_attribute>
    <content_attribute id="money-gambling">none</content_attribute>
  </content_rating>

  <releases>
    <!-- Release notes are what GNOME Software shows under "What's new".
         Keep each one short: at most ten items, the ones a reader will
         notice most, in plain words and short sentences, with no em-dashes.
         The full record belongs in CHANGELOG.md, not here.
         tests/test_version_sync.py holds every release to this. -->
    <release version="1.7.3" date="2026-09-22">
      <description its:translate="no">
        <p>Search the Greek and Hebrew behind the translation, and hear more of the fathers.</p>
        <ul>
          <li>Search by the word under the translation. strong:G26 finds every verse whose Greek carries that word, and lemma: and morph: ask the same of the spelling and the grammar.</li>
          <li>The occurrences beside a Strong's definition can now cover the whole Bible, not only the book you are reading.</li>
          <li>The historical commentaries add about 2,000 comments, most of them Origen. The Module Manager offers the new pack.</li>
          <li>Double-clicking a word in a Russian Bible finds its dictionary article far more often. Update the Russian dictionary to get this.</li>
          <li>The interface font now ships with the app, so the text looks the same on every desktop.</li>
          <li>On desktops that put the app icon in the window bar, such as KDE, it no longer appears there.</li>
          <li>Evening paper now says when your desktop has no Night Light, instead of doing nothing.</li>
          <li>The starting library cards say how much each one downloads.</li>
          <li>Where the system cannot play audio, no play button is offered.</li>
          <li>A file chooser that cannot open now says so, and the Share and Written on this chapter menus fit their rows.</li>
        </ul>
      </description>
    </release>
    <release version="1.7.2" date="2026-09-17">
      <description its:translate="no">
        <p>Your writing is kept safer, and the interlinears show more.</p>
        <ul>
          <li>A daily copy of your notes, journal and sermons is kept on this device. Restore keeps a copy of what it replaces.</li>
          <li>Closing the app or logging out no longer loses the last sentence you typed.</li>
          <li>Opening the app a second time no longer risks your notes. It brings the open window forward.</li>
          <li>Find and replace in journal entries and sermons, with Ctrl+F.</li>
          <li>The Greek interlinear can show the words other editions add or change.</li>
          <li>The Hebrew interlinear can show the form the scribes wrote under the form that is read.</li>
          <li>Type a verse reference in the GNOME search to see it and open it.</li>
          <li>Ctrl+D bookmarks the chapter. Alt+[ and Alt+] go back and forward.</li>
          <li>The annotations list shows the verse and updates itself.</li>
          <li>Highlights sat one word late when footnotes were hidden. This is fixed.</li>
        </ul>
      </description>
    </release>
    <release version="1.7.1" date="2026-09-15">
      <!-- English only, by his call, as 1.6.1 and 1.6.2 shipped:
           its:translate="no" is what keeps xgettext out of them and both
           catalogues at 100%. -->
      <description its:translate="no">
        <p>Fixes for writing sermons.</p>
        <ul>
          <li>Giving a sermon a series could close the app. This is fixed.</li>
          <li>Typing in a long sermon no longer gets slower as the text grows.</li>
          <li>Russian: the verse menu item for a new journal entry no longer reads as “add a bookmark”.</li>
        </ul>
      </description>
    </release>
    <release version="1.7.0" date="2026-09-14">
      <!-- English only, by his call, as 1.6.1 and 1.6.2 shipped:
           its:translate="no" is what keeps xgettext out of them and both
           catalogues at 100%. -->
      <description its:translate="no">
        <p>A place to write: a journal, sermons, and a new Today page.</p>
        <ul>
          <li>A journal. Write an entry about one passage, several, or none, and add or remove passages later.</li>
          <li>Sermons. Keep each sermon with its passages, its main idea, its series and the days you preached it. Print or export it on its own.</li>
          <li>While you write a sermon, bring in your notes, highlights, verses, cross-references and word studies on the passage.</li>
          <li>The Annotations window has three pages: Annotations, Journal and Sermons, each with its own search and filters.</li>
          <li>Room to write, with buttons for bold, italic, headings, quotes and lists, and a word count.</li>
          <li>Print, export and compare translations from the new ⋮ button, or with Ctrl+P, Ctrl+E and Ctrl+Shift+C. Before, they were only in the right-click menu.</li>
          <li>The Today page shows the first verse of the day's reading, on a new parchment background.</li>
          <li>Search finds your own notes and entries as well as Bible verses.</li>
          <li>The right-click menu is shorter and grouped.</li>
          <li>Fixed: double-clicking a word said “No entry” even with dictionaries installed, and a reading plan could say it was done when it was not.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.2" date="2026-09-10">
      <!-- English only, by his call, as 1.6.1 shipped: its:translate="no"
           is what keeps xgettext out of them and both catalogues at 100%. -->
      <description its:translate="no">
        <p>Your marks now show in every translation, and many fixes.</p>
        <ul>
          <li>Highlights, underlines, notes and tags now show in every translation, not only the one you made them in. The Study Journal is now called Annotations.</li>
          <li>Export, print and copy work for Bibles from eBible, and marks made in them land on the right verse.</li>
          <li>Psalm numbers are right in the Clementine Vulgate and the Russian Synodal Bible from eBible.</li>
          <li>“Match case” no longer turns an OR search into an AND search.</li>
          <li>A link to a book your Bible does not have now tells you which book is missing, instead of doing nothing.</li>
          <li>The Orthodox Old Calendar is offered beside the New Calendar.</li>
          <li>Russian readers get the Orthodox troparion in Church Slavonic, not in English.</li>
          <li>Dates show in the app's language, not always in English.</li>
          <li>A stray space before commas is gone from the Today page, devotionals, cross-references, dictionaries and collects.</li>
          <li>Highlights cover the whole verse and stay beside the right text.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.1" date="2026-09-02">
      <!-- English only, by his call: a patch release's notes are not
           worth stranding two catalogues at 99%. its:translate="no" is what
           keeps xgettext out of them. -->
      <description its:translate="no">
        <p>Two fixes for 1.6.0.</p>
        <ul>
          <li>The right-click menu now opens in the middle of the page on small windows.</li>
          <li>The Book of Generations opens at the text size you chose.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.0" date="2026-09-02">
      <description>
        <p>Scriptura in Russian, and the Bible's lists of names drawn as charts.</p>
        <ul>
          <li>The app is now in Russian, with the book names Russian readers expect.</li>
          <li>A modern Russian Bible under a free licence, and the first Russian dictionary.</li>
          <li>The Book of Generations draws the Bible's family lists as charts, one to a page. Click a name to learn about the person, or a verse to read it.</li>
          <li>On first run you pick your language, and the app offers Bibles, a dictionary and study tools in it.</li>
          <li>A Spanish dictionary, the first in any SWORD source.</li>
          <li>Scripture in Stone is in your language, and opens at once instead of loading every photo first.</li>
          <li>Go to a passage with book names in your own language, such as «Бытие 3» or Génesis 3.</li>
          <li>Book names on cross-references and search charts are translated.</li>
          <li>Translated labels are no longer cut off.</li>
          <li>First-run downloads are more reliable, and closing the window during one no longer leaves half a library behind.</li>
        </ul>
      </description>
    </release>
    <release version="1.5.0" date="2026-08-19">
      <description>
        <p>Scriptura in Spanish, and books it could not open before.</p>
        <ul>
          <li>The app is now in Spanish. Pick the language on the first screen or from the menu.</li>
          <li>Spanish Bibles: LBLA, NBLA, the Versión Biblia Libre, and Straubinger's with its long notes.</li>
          <li>The whole Bible read aloud in Spanish, from La Biblia en Español Sencillo.</li>
          <li>Books such as Tobit, Judith, Sirach and Maccabees now open. Before, asking for one showed Revelation.</li>
          <li>Every dictionary you install now shows, in any language, and so do Strong's numbers in Spanish Bibles.</li>
          <li>Set wider spacing between letters, or use the OpenDyslexic font.</li>
          <li>The app follows the desktop's High Contrast setting.</li>
          <li>An optional reading focus dims all but the passage you are reading.</li>
          <li>Audio shows on your desktop's media controls and media keys.</li>
          <li>The page no longer jumps when you change the theme and other display settings.</li>
        </ul>
      </description>
    </release>
    <release version="1.4.0" date="2026-07-27">
      <description>
        <p>Chapters read aloud, and passages you can take with you.</p>
        <ul>
          <li>Listen to chapters of the Berean Standard Bible read aloud. Skip back, change the speed, and keep listening into the next chapter.</li>
          <li>Listen to devotionals: Spurgeon's Morning and Evening, the Psalms, and Daily Strength on the Today page.</li>
          <li>Export a passage as a study sheet with your notes and highlights.</li>
          <li>Save or copy a verse as an image.</li>
          <li>Print a passage as a study handout.</li>
          <li>Section headings from your Bible now show. Press [ and ] to move between sections.</li>
          <li>Use the reading pane from the keyboard, with screen reader support.</li>
          <li>Every Bible opens each chapter with a large first letter, and commentaries show their titles.</li>
          <li>More prayers from the Roman calendar, and a steadier Today page.</li>
          <li>Modules still install when CrossWire's server is down.</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-07-10">
      <description>
        <p>The original languages, word by word.</p>
        <ul>
          <li>Read the Greek New Testament and the Hebrew Old Testament word by word, each word with its English meaning and grammar.</li>
          <li>A Greek lexicon pack with Abbott-Smith and Liddell-Scott-Jones. Click a verse in an entry to read it.</li>
          <li>Press F5 to show a passage full screen on a projector, alone or beside a second translation.</li>
          <li>Maps link to their passages, and commentaries show the places a verse names.</li>
          <li>Greek accents now display correctly.</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-07-05">
      <description>
        <p>Getting started is easier.</p>
        <ul>
          <li>A new Tips &amp; Gestures guide in the menu lists every reading gesture.</li>
          <li>One-time tips show hidden gestures when you first need them. You can turn them off.</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-06-28">
      <description>
        <p>Choose how your reading page looks.</p>
        <ul>
          <li>A new Appearance panel: choose a paper colour, and the text colour follows it.</li>
          <li>Bold and justified text are small buttons beside the font.</li>
          <li>Reading plans have a Today view and a month calendar.</li>
          <li>Fixed faint trails left behind when scrolling.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-05-28">
      <description>
        <p>Packaging fixes.</p>
        <ul>
          <li>Convert the build to meson for a cleaner Flatpak install.</li>
          <li>Patch SWORD's CMake to properly link libcurl (upstream bug API-263).</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-05-23">
      <description>
        <p>
          Scriptura's first release. Read two translations side by side,
          study the Hebrew and Greek behind any word, follow
          cross-references, and keep your highlights and notes in one
          searchable place, all offline on your own computer.
        </p>
      </description>
    </release>
  </releases>
</component>
