    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/02-historical-commentaries.png</image>
      <caption>The Historical Commentaries pane — the church's voices on a verse, across the centuries</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/andresmessina-SDG/scriptura/main/data/screenshots/03-study-journal.png</image>
